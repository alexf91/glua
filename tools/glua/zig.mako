// CODE GENERATED BY glua
// DO NOT EDIT

<%!
import sys
from glua.types import ArrayDef, FieldDef, TypeDef, UnionDef
%>

## Generate a push function for compound types.
<%def name="generatePush(tp: TypeDef)">
/// Push a value.
pub fn push(L: *Lua, value: ${tp.iname}) !void {
    // TODO: implement
    _ = L;
    _ = value;
    return Error.GeneralError;
}
</%def>

## Generate a read function for compound types.
<%def name="generateRead(tp: TypeDef)">
/// Read a value.
pub fn read(L: *Lua, index: i32) !${tp.iname} {
    try checkStackIndex(L, index);
    const absIndex = L.absIndex(index);
    if (!L.isTable(absIndex))
        return Error.TypeError;
    var value: ${tp.iname} = undefined;

    // Cleanup logic.
    var initialized : struct {
        % for field in tp.allfields:
            ${field.name} : bool = false,
        % endfor
    } = .{};
    errdefer {
        % for field in tp.fields:
            if (initialized.${field.name}) ${field.type}.free(L, value.${field.name});
        % endfor
        % for field in tp.arrays:
            if (initialized.${field.name}) ${field.type}.freeArray(L, value.${field.name});
        % endfor
        % for field in tp.unions:
            <% raise NotImplementedError("support for unions not implemented") %>
        % endfor
    }

    % for field in tp.allfields:
        // Read field ${field.name}.
        _ = L.getField(absIndex, "${field.name}");
        defer L.pop(1);
        if (L.isNil(-1)) {
            % if field.optional:
                <% raise NotImplementedError("optional fields not implemented") %>
            % endif
        } else {
            % if isinstance(field, FieldDef):
                value.${field.name} = try ${field.type}.read(L, -1);
                initialized.${field.name} = true;
            % elif isinstance(field, ArrayDef):
                value.${field.name} = try ${field.type}.readArray(L, -1);
                ## This is just for compatibility. Zig arrays have their length field included,
                ## so they should always be declared as dynamic.
                % if not field.dynamic:
                    value.${field.length} = value.${field.name}.len;
                % endif
                initialized.${field.name} = true;
            % elif isinstance(field, UnionDef):
                <% raise NotImplementedError("optional fields not implemented") %>
            % endif
        }
    % endfor

    return value;
}
</%def>

## Generate a free function for compound types.
<%def name="generateFree(tp: TypeDef)">
/// Free a value.
pub fn free(L: *Lua, value: ${tp.iname}) void {
    % for field in tp.allfields:
        % if isinstance(field, FieldDef):
            ${field.type}.free(L, value.${field.name});
        % elif isinstance(field, ArrayDef):
            ${field.type}.freeArray(L, value.${field.name});
        % elif isinstance(field, UnionDef):
        % endif
    % endfor
}
</%def>

## Generate a pushArray function.
<%def name="generatePushArray(zigtype)">
/// Push an array.
pub fn pushArray(L: *Lua, values: []const ${zigtype}) !void {
    return pushArrayImpl(${zigtype}, push, L, values);
}
</%def>

## Generate a readArray function.
<%def name="generateReadArray(zigtype)">
/// Read an array.
pub fn readArray(L: *Lua, index: i32) ![]${zigtype} {
    try checkStackIndex(L, index);
    return readArrayImpl(${zigtype}, read, L, index);
}
</%def>

## Generate a freeArray function.
<%def name="generateFreeArray(zigtype)">
/// Free an array.
pub fn freeArray(L: *Lua, values: []${zigtype}) void {
    return freeArrayImpl(${zigtype}, free, L, values);
}
</%def>

<%
# Setup the mapping from Glua types to internal types.
TYPEMAP = {
    "Integer": "zlua.Integer",
    "Number": "zlua.Number",
    "String": "*u8",
    "LuaRef": "i32",
    "Boolean": "bool"
}

def temptype(typename : str) -> str:
    """Map a type to a temporary intermediate type."""
    return TYPEMAP.get(typename, typename)

# Get the set of headers.
headers = default_headers.copy()
for tp in types:
    headers.update(tp.headers)
    TYPEMAP[tp.name] = tp.iname
import sys
%>

## Include necessary headers.
% for var, module in headers.items():
const ${var} = @import("${module}");
% endfor

const Lua = zlua.Lua;

/// Check if a stack index is valid.
pub fn checkStackIndex(L: *Lua, index: i32) !void {
    const absIndex = L.absIndex(index);
    if (absIndex < 1 or absIndex > L.getTop())
        return Error.StackError;
}

/// Read an array.
fn readArrayImpl(comptime T: type, comptime readValue: anytype, L: *Lua, index: i32) ![]T {
    try checkStackIndex(L, index);
    if (L.typeOf(index) != zlua.LuaType.table)
        return Error.TypeError;

    L.len(index);
    const length = try L.toInteger(-1);
    L.pop(1);
    std.debug.assert(length >= 0);

    const values = try L.allocator().alloc(T, @intCast(length));
    errdefer L.allocator().free(values);

    var i: usize = 0;
    while (i < length) {
        _ = L.getIndex(index, @intCast(i + 1));
        values[i] = try readValue(L, -1);
        L.pop(1);
        i += 1;
    }
    return values;
}

/// Free an array.
fn freeArrayImpl(comptime T: type, comptime freeValue: anytype, L: *Lua, values: []T) void {
    var i: usize = 0;
    for (values) |value| {
        freeValue(L, value);
        i += 1;
    }
    L.allocator().free(values);
}

/// Push an array.
fn pushArrayImpl(comptime T: type, comptime pushValue: anytype, L: *Lua, values: []const T) !void {
    var i: usize = 0;
    L.newTable();
    while (i < values.len) {
        try pushValue(L, values[i]);
        errdefer L.pop(1);
        L.setIndex(-2, @intCast(i + 1));
        i += 1;
    }
}

/// Error types used in generated code.
pub const Error = error{
    GeneralError,
    NilError,
    UnionError,
    StackError,
    RefError,
    TypeError,
};

pub const Integer = struct {
    /// Push a value to the stack.
    pub fn push(L: *Lua, value: zlua.Integer) !void {
        L.pushInteger(value);
    }

    /// Read a value from the stack index `index`.
    pub fn read(L: *Lua, index: i32) !zlua.Integer {
        try checkStackIndex(L, index);
        if (!L.isInteger(index))
            return if (L.isNil(index)) Error.NilError else Error.TypeError;
        return L.toInteger(index);
    }

    /// Free a value.
    pub fn free(L: *Lua, value: zlua.Integer) void {
        _ = L;
        _ = value;
    }
    ${generateReadArray("zlua.Integer")}
    ${generatePushArray("zlua.Integer")}
    ${generateFreeArray("zlua.Integer")}
};

pub const Number = struct {
    /// Push a value to the stack.
    pub fn push(L: *Lua, value: zlua.Number) !void {
        L.pushNumber(value);
    }

    /// Read a value from the stack index `index`.
    pub fn read(L: *Lua, index: i32) !zlua.Number {
        try checkStackIndex(L, index);
        if (L.typeOf(index) != zlua.LuaType.number)
            return if (L.isNil(index)) Error.NilError else Error.TypeError;
        return L.toNumber(index);
    }

    /// Free a value.
    pub fn free(L: *Lua, value: zlua.Number) void {
        _ = L;
        _ = value;
    }

    ${generateReadArray("zlua.Number")}
    ${generatePushArray("zlua.Number")}
    ${generateFreeArray("zlua.Number")}
};

pub const String = struct {
    /// Push a value to the stack.
    pub fn push(L: *Lua, value: []const u8) !void {
        _ = L.pushString(value);
    }

    /// Read a value from the stack index `index`.
    pub fn read(L: *Lua, index: i32) ![]const u8 {
        try checkStackIndex(L, index);
        if (L.typeOf(index) != zlua.LuaType.string)
            return if (L.isNil(index)) Error.NilError else Error.TypeError;

        // Operate on a copy of `index` to avoid modifying the stack.
        L.pushValue(index);
        defer L.pop(1);
        const value = try L.toString(-1);
        return L.allocator().dupe(u8, value);
    }

    /// Free a value.
    pub fn free(L: *Lua, value: []const u8) void {
        L.allocator().free(value);
    }

    ${generateReadArray("[]const u8")}
    ${generatePushArray("[]const u8")}
    ${generateFreeArray("[]const u8")}
};

## Generate functions for compound types.
% for tp in types:
pub const ${tp.name} = struct {
    ${generatePush(tp)}
    ${generateRead(tp)}
    ${generateFree(tp)}
    ${generateReadArray(tp.iname)}
    ${generatePushArray(tp.iname)}
    ${generateFreeArray(tp.iname)}
};
% endfor
