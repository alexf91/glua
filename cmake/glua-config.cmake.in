@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Make the bundled find modules available to find_dependency().
list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")

include("${CMAKE_CURRENT_LIST_DIR}/gluaTargets.cmake")

# Location of the code generator tools.
set_and_check(GLUA_TOOLS "@PACKAGE_GLUA_TOOLS_DIR@")

# Code generation function glua_target().
include("${CMAKE_CURRENT_LIST_DIR}/glua.cmake")

check_required_components(glua)
